{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.15.2",
        "laravel/framework": "^13.23",
        "laravel/octane": "^2.18.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "pusher/pusher-php-server": "^7.2.8",
        "rakutentech/laravel-request-docs": "^2.44",
        "spatie/laravel-permission": "^7.4.2",
        "spiral/roadrunner": "^2025.1.15"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "laravel/sail": "^1.64.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "larastan/larastan": "^3.10.0",
        "orchestra/testbench": "^11.1.0",
        "phpstan/phpstan": "^2.2.7",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpunit/phpunit": "^12.5.33",
        "rector/rector": "^2.5.9",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.12",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "@composer validate",
            "@composer dumpautoload",
            "@php ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff -v --dry-run",
            "@php ./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "lint:fix": [
            "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php -v"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
